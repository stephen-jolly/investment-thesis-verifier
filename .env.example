# 轻量模型（用于简单分类、摘要）
ARK_MODEL_LITE=doubao-seed-2-0-lite-260215

# 同花顺 iFinD MCP（可选；提供公告原文、金融指标、新闻、宏观行业数据）
IFIND_MCP_TOKEN=
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-mcp
