# 扶摇金融数据 API
FUYAO_API_KEY=sk-fuyao-your-key-here

# 火山引擎方舟（豆包）大模型 API
ARK_API_KEY=ark-your-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 主模型（用于命题拆解、证据分析、结论生成）
